NODE_ENV=development
LOG_LEVEL=info

# Stellar facilitator configuration. Never commit real secrets.
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FACILITATOR_PRIVATE_KEY=
# Optional comma-separated signer pool. Takes precedence when set.
STELLAR_FACILITATOR_PRIVATE_KEYS=
STELLAR_FEE_BUMP_PRIVATE_KEY=
STELLAR_MAX_TX_FEE_STROOPS=50000

# HTTP service
HOST=0.0.0.0
PORT=4022
