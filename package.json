{
  "name": "@aifinpay/stellar-x402-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Working Stellar x402 facilitator and Bazaar discovery prototype for AiFinPay",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:facilitator": "tsx packages/facilitator/src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:stellar": "tsx tests/e2e/stellar-testnet.ts",
    "evaluate:discovery": "tsx packages/bazaar/src/evaluate.ts",
    "check": "npm run format:check && npm run lint:md && npm run typecheck && npm run test && npm run evaluate:discovery"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.3.0",
    "@x402/core": "2.25.0",
    "@x402/stellar": "2.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
